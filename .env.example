# Frontend build-time configuration (public: every VITE_* value is readable in
# the shipped JavaScript). Never put secrets here. Copy to .env for local dev.
VITE_MARINE_API_BASE=/api/v1
# Server-authoritative calculation over WebSocket (M7; off by default).
VITE_SERVER_CALCULATION=false
VITE_CALC_SHADOW=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LOVABLE_CONNECTOR_MAPBOX_PUBLIC_TOKEN=
# Local development only (vite.config.ts): proxy /api/v1 and the WebSocket to a local API.
# DEV_API_PROXY=http://localhost:8090
